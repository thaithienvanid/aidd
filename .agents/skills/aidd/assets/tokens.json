{
  "$description": "The repository's design tokens, in the Design Tokens Format Module 2025.10. Raw values (color.blue-700) sit at the top of a group; roles alias them, one set per theme with the same role names: color.light.accent and color.dark.accent. Screens use roles only, by name (color.accent is the role in the active theme). Each group under color is a theme preset with the same role names; node design/build.mjs writes design/tokens.css, design/themes/<theme>.css, and DESIGN.md's token front matter from this file, the one source, and --check is the drift test. A tool that reads the Design Tokens Resolver Module 2025.10 can take the two sets as a theme modifier with the contexts light and dark. Change it in its own change (baseline:design-system).",
  "color": {
    "$type": "color",
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
    "gray-50": { "$value": { "colorSpace": "srgb", "components": [0.953, 0.957, 0.961] } },
    "gray-400": { "$value": { "colorSpace": "srgb", "components": [0.62, 0.647, 0.69] } },
    "gray-600": { "$value": { "colorSpace": "srgb", "components": [0.357, 0.38, 0.42] } },
    "gray-900": { "$value": { "colorSpace": "srgb", "components": [0.11, 0.118, 0.129] } },
    "gray-950": { "$value": { "colorSpace": "srgb", "components": [0.067, 0.075, 0.09] } },
    "blue-300": { "$value": { "colorSpace": "srgb", "components": [0.576, 0.773, 0.992] } },
    "blue-700": { "$value": { "colorSpace": "srgb", "components": [0.114, 0.306, 0.847] } },
    "red-300": { "$value": { "colorSpace": "srgb", "components": [0.988, 0.647, 0.647] } },
    "red-700": { "$value": { "colorSpace": "srgb", "components": [0.725, 0.11, 0.11] } },
    "blue-100": { "$value": { "colorSpace": "srgb", "components": [0.859, 0.894, 1] } },
    "blue-900": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.204, 0.361] } },
    "green-300": { "$value": { "colorSpace": "srgb", "components": [0.278, 0.804, 0.537] } },
    "green-700": { "$value": { "colorSpace": "srgb", "components": [0.024, 0.463, 0.278] } },
    "amber-100": { "$value": { "colorSpace": "srgb", "components": [1, 0.957, 0.8] } },
    "amber-300": { "$value": { "colorSpace": "srgb", "components": [0.992, 0.69, 0.133] } },
    "amber-800": { "$value": { "colorSpace": "srgb", "components": [0.541, 0.294, 0] } },
    "amber-950": { "$value": { "colorSpace": "srgb", "components": [0.227, 0.188, 0] } },
    "light": {
      "$description": "The light theme's roles.",
      "surface": { "$value": "{color.white}", "$description": "Page and card background" },
      "surface-raised": { "$value": "{color.gray-50}", "$description": "Panels, bars, and app chrome; text keeps 4.5:1 on it" },
      "text": { "$value": "{color.gray-900}", "$description": "Body text; 4.5:1 on surface" },
      "text-muted": { "$value": "{color.gray-600}", "$description": "Secondary text and control edges; 4.5:1 on surface" },
      "accent": { "$value": "{color.blue-700}", "$description": "Primary actions and links" },
      "accent-subtle": { "$value": "{color.blue-100}", "$description": "The selected item's background; text keeps 4.5:1 on it" },
      "danger": { "$value": "{color.red-700}", "$description": "Destructive actions and errors" },
      "success": { "$value": "{color.green-700}", "$description": "Success text; 4.5:1 on surface" },
      "warning": { "$value": "{color.amber-800}", "$description": "Warning text; 4.5:1 on surface" },
      "warning-subtle": { "$value": "{color.amber-100}", "$description": "A notice's background; text keeps 4.5:1 on it" },
      "focus": { "$value": "{color.blue-700}", "$description": "Focus indicator; 3:1 on surface" }
    },
    "dark": {
      "$description": "The dark theme's roles: the same names as light, each checked for contrast on its own surface.",
      "surface": { "$value": "{color.gray-950}", "$description": "Page and card background" },
      "surface-raised": { "$value": "{color.gray-900}", "$description": "Panels, bars, and app chrome; text keeps 4.5:1 on it" },
      "text": { "$value": "{color.gray-50}", "$description": "Body text; 4.5:1 on surface" },
      "text-muted": { "$value": "{color.gray-400}", "$description": "Secondary text and control edges; 4.5:1 on surface" },
      "accent": { "$value": "{color.blue-300}", "$description": "Primary actions and links" },
      "accent-subtle": { "$value": "{color.blue-900}", "$description": "The selected item's background; text keeps 4.5:1 on it" },
      "danger": { "$value": "{color.red-300}", "$description": "Destructive actions and errors" },
      "success": { "$value": "{color.green-300}", "$description": "Success text; 4.5:1 on surface" },
      "warning": { "$value": "{color.amber-300}", "$description": "Warning text; 4.5:1 on surface" },
      "warning-subtle": { "$value": "{color.amber-950}", "$description": "A notice's background; text keeps 4.5:1 on it" },
      "focus": { "$value": "{color.blue-300}", "$description": "Focus indicator; 3:1 on surface" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 16, "unit": "px" } },
    "4": { "$value": { "value": 24, "unit": "px" } },
    "5": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 6, "unit": "px" } },
    "surface": { "$value": { "value": 12, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "target-min": { "$value": { "value": 24, "unit": "px" }, "$description": "The smallest target a control draws (WCAG 2.2 SC 2.5.8)" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 1, "unit": "rem" } },
      "heading": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "tracking": {
      "$type": "dimension",
      "normal": { "$value": { "value": 0, "unit": "px" } }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.body}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.tracking.normal}",
        "lineHeight": 1.5
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.heading}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.tracking.normal}",
        "lineHeight": 1.25
      }
    }
  }
}
