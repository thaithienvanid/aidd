{
  "summary": "Local-first under gates.local_approvals = \"signed\": the same approvals without verified: true (the adapter could not verify their git signature) do not count, so both approvals stay pending and each dropped one is named.",
  "ops": [
    {
      "op": "set",
      "path": "/platform",
      "value": "local"
    },
    {
      "op": "replace_text",
      "path": "/base_config",
      "old": "  approvers: [van]\n",
      "new": "  approvers: [email:van@example.com]\ngates:\n  local_approvals: signed\n"
    },
    {
      "op": "set",
      "path": "/change/author",
      "value": "email:van@example.com"
    },
    {
      "op": "set",
      "path": "/commits/0/author",
      "value": "email:van@example.com"
    },
    {
      "op": "set",
      "path": "/commits/0/committer",
      "value": "email:van@example.com"
    },
    {
      "op": "set",
      "path": "/comments/0/user",
      "value": "email:van@example.com"
    },
    {
      "op": "remove",
      "path": "/comments/1"
    },
    {
      "op": "append",
      "path": "/reviews",
      "value": {
        "user": "email:van@example.com",
        "state": "approved",
        "commit_sha": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "submitted_at": "2026-09-23T09:45:00Z"
      }
    }
  ],
  "expected": {
    "decision": "pending",
    "failed_rules": [],
    "pending_rules": [
      "merge_approval",
      "spec_approval"
    ],
    "warn_rules": [
      "merge_approval",
      "spec_approval"
    ],
    "findings": [
      "pending merge_approval.missing",
      "pending spec_approval.missing",
      "warn merge_approval.unsigned",
      "warn spec_approval.unsigned"
    ]
  }
}
