{
  "summary": "Local-first: the same solo change approved on one machine, where approvals come from email: identities recorded on refs/aidd/approvals, passes as it does on a platform.",
  "ops": [
    {
      "op": "set",
      "path": "/platform",
      "value": "local"
    },
    {
      "op": "replace_text",
      "path": "/base_config",
      "old": "approvers = [\"van\"]",
      "new": "approvers = [\"email:van@example.com\"]"
    },
    {
      "op": "set",
      "path": "/change/author",
      "value": "email:van@example.com"
    },
    {
      "op": "set",
      "path": "/commits/0/author",
      "value": "email:van@example.com"
    },
    {
      "op": "set",
      "path": "/commits/0/committer",
      "value": "email:van@example.com"
    },
    {
      "op": "set",
      "path": "/comments/0/user",
      "value": "email:van@example.com"
    },
    {
      "op": "remove",
      "path": "/comments/1"
    },
    {
      "op": "append",
      "path": "/reviews",
      "value": {
        "user": "email:van@example.com",
        "state": "approved",
        "commit_sha": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "submitted_at": "2026-09-23T09:45:00Z"
      }
    }
  ],
  "expected": {
    "decision": "pass",
    "failed_rules": [],
    "pending_rules": [],
    "warn_rules": [],
    "findings": []
  }
}
