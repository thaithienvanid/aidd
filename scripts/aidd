#!/bin/sh
# The aidd CLI from the aidd plugin's own source, so that in Claude Code `aidd init`, `aidd list`, and the rest work with
# the plugin alone: the skill names it as "${CLAUDE_PLUGIN_ROOT}/scripts/aidd" (not bin/, which claude.ai and Cowork
# refuse in a plugin). Python comes from PATH, read from the plugin's folder, and never from inside the project or the
# current folder, which a repository could plant.
unset CDPATH; unset -f test cd pwd command 2>/dev/null
R=$(cd -P -- "${0%/*}/../src" 2>/dev/null && pwd -P) || { echo "aidd: the plugin's source is missing next to $0" >&2; exit 1; }
L='import sys; sys.version_info < (3, 11) and sys.exit(3); sys.path.insert(0, sys.argv.pop(1)); sys.argv[0] = sys.argv.pop(1); from aidd.cli import main; sys.exit(main())'
D=$(cd -P -- "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null && pwd -P) || D=
W=$(pwd -P)
ok() { case "$1" in /*) ;; *) return 1;; esac; p=$(cd -P -- "${1%/*}/" 2>/dev/null && pwd -P) || return 1; for d in "$D" "$W"; do test -n "$d" || return 1; x=$p; while :; do test "$x" -ef "$d" && return 1; case "$x" in ""|/) break;; esac; x=${x%/*}; test -n "$x" || x=/; done; done; }
ok "$R/aidd" || { echo "aidd: the plugin's source is inside this folder; run aidd from your own install here" >&2; exit 1; }
P3=$(cd -P -- "$R" && command -v python3)
if ok "$P3" && "$P3" -I -S -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then exec "$P3" -I -S -c "$L" "$R" aidd "$@"; fi
PY=; UV=$(cd -P -- "$R" && command -v uv)
if ok "$UV"; then PY=$(cd -P -- "$R" && unset VIRTUAL_ENV && "$UV" python find --offline --no-project --no-config --no-python-downloads --system '>=3.11' 2>/dev/null) && ok "$PY" || PY=; fi
test -n "$PY" && exec "$PY" -I -S -c "$L" "$R" aidd "$@"
echo "aidd: could not start (it needs Python 3.11 or later, or uv with a Python outside any virtual environment: uv python install 3.12)" >&2
exit 1
