  "actions": {
    "code.edit": {
      "description": "Edit a file in the repository.",
      "commands": [],
      "examples": [
        "write or change a source file, a test, or a doc"
      ]
    },
    "intent.agree": {
      "description": "Start the work an Intent plans: a person's agreement to its goal and its slices, which the commit with its `Agreed-by` trailer records, in either form git takes. A commit whose message only names the word asks too, a needless ask the net accepts.",
      "commands": [
        "git commit *Agreed-by*"
      ],
      "examples": [
        "the Intent's goal, phases, and slices are written, and Specify would start on its first slice"
      ]
    },
    "spec.approve": {
      "description": "Start building a Spec: its approval.",
      "commands": [],
      "examples": [
        "the Spec, its tests, and its design are written, and Implement would start"
      ]
    },
    "spec.revise": {
      "description": "Change a Spec's tests, Acceptance, or design after its approval.",
      "commands": [],
      "examples": [
        "edit a test file an approved Spec lists",
        "change an approved Spec's Acceptance"
      ]
    },
    "git.commit": {
      "description": "Make a commit.",
      "commands": [
        "git commit*"
      ],
      "examples": []
    },
    "git.push": {
      "description": "Push commits to a remote.",
      "commands": [
        "git push*"
      ],
      "api_endpoints": [
        "PATCH|POST */git/refs*",
        "PUT|DELETE */contents/*",
        "POST */merges",
        "graphql#mutation *updateRef*"
      ],
      "examples": []
    },
    "git.push.force": {
      "description": "Push that replaces history on the remote.",
      "irreversible": true,
      "commands": [
        "git push --force*",
        "git push -f*",
        "git push * --force*",
        "git push * -f*",
        "git push * +*",
        "git push --force-with-lease*",
        "git push * --force-with-lease*"
      ],
      "api_endpoints": [
        "PATCH */git/refs/* *force=true*",
        "PATCH */git/refs/* --input*"
      ],
      "examples": [
        "a push whose refspec starts with +"
      ]
    },
    "git.history.rewrite": {
      "description": "Rewrite commits others may have, or discard uncommitted work: a push of a rebased or amended branch is a force push, which asks.",
      "irreversible": true,
      "commands": [
        "git reset --hard*",
        "git filter-branch*",
        "git filter-repo*"
      ],
      "examples": [
        "squash or reorder commits already pushed"
      ]
    },
    "git.branch.delete": {
      "description": "Delete a branch, here or on a remote.",
      "irreversible": true,
      "commands": [
        "git branch -d*",
        "git branch -D*",
        "git branch --delete*",
        "git push * --delete*",
        "git push * :*",
        "git push -d*",
        "git push --delete*",
        "git push * -d*"
      ],
      "api_endpoints": [
        "DELETE */git/refs/*"
      ],
      "examples": []
    },
    "git.tag.create": {
      "description": "Create or move a tag, such as a release tag.",
      "commands": [
        "git tag*"
      ],
      "examples": []
    },
    "git.merge": {
      "description": "Merge another branch's work into the branch checked out: a `git merge`, or a `git pull` that names a remote, a path, or a branch.",
      "commands": [
        "git merge",
        "git merge *",
        "git pull",
        "git pull *"
      ],
      "examples": [
        "a `git cherry-pick` or `git rebase` that brings another branch's work onto the default branch"
      ]
    },
    "pr.open": {
      "description": "Open a pull request or merge request (a PR/MR).",
      "commands": [
        "gh pr create*",
        "glab mr create*"
      ],
      "examples": []
    },
    "pr.merge": {
      "description": "Merge a PR/MR into its base.",
      "commands": [
        "gh pr merge*",
        "glab mr merge*"
      ],
      "api_endpoints": [
        "PUT */pulls/*/merge",
        "graphql#mutation *mergePullRequest*"
      ],
      "examples": []
    },
    "workflow.run": {
      "description": "Start or re-run a CI workflow by hand, such as `gh workflow run ci.yml` or `gh run rerun 123`. One whose name, in any of its three common cases, holds release, publish, or deploy is also `release.publish` or `deploy.run`, which ask. A workflow named by its number shows no name, so it reports: check what it runs first.",
      "commands": [
        "gh workflow run*",
        "gh run rerun*",
        "glab ci run*",
        "glab ci trigger*",
        "glab ci retry*",
        "glab api *POST*pipeline*"
      ],
      "api_endpoints": [
        "*dispatches*",
        "POST */actions/runs/*/rerun*",
        "POST */actions/jobs/*/rerun*",
        "POST */check-suites/*/rerequest*"
      ],
      "examples": [
        "re-run CI on a branch by hand"
      ]
    },
    "dependency.add": {
      "description": "Add a third-party package to the project: a new entry in a manifest, which its install may run code from.",
      "commands": [
        "npm install *",
        "npm i *",
        "npm add *",
        "pnpm add *",
        "yarn add *",
        "bun add *",
        "pip install *",
        "uv add *",
        "uv pip install *",
        "poetry add *",
        "pipenv install *",
        "cargo add *",
        "go get *",
        "bundle add *",
        "gem install *",
        "composer require *",
        "dotnet add * package *"
      ],
      "examples": [
        "a new package name written into a manifest by hand"
