        "flyway migrate*",
        "dotnet ef database update*",
        "wrangler d1 migrations apply*",
        "rails db:migrate*"
      ],
      "examples": [
        "apply a new migration to the local database the tests use"
      ]
    },
    "migration.rollback": {
      "description": "Reverse applied migrations: roll them back, downgrade, undo, reset, or refresh them, which loses the data the reversed steps held.",
      "irreversible": true,
      "commands": [
        "php artisan migrate:refresh*",
        "php artisan migrate:reset*",
        "php artisan migrate:rollback*",
        "alembic downgrade*",
        "alembic*downgrade*",
        "python manage.py migrate*zero*",
        "python manage.py migrate* 0*",
        "atlas migrate down*",
        "flyway undo*",
        "flyway*undo*",
        "dotnet ef database update 0",
        "dotnet ef database update 0 *",
        "dotnet ef migrations remove*--force*",
        "rails db:rollback*",
        "rails db:migrate:redo*",
        "rails db:migrate:down*",
        "rails db:migrate*VERSION=*"
      ],
      "examples": [
        "apply an older migration by name, which reverses the ones after it, such as `dotnet ef database update InitialCreate`"
      ]
    },
