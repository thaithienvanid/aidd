  "actions": {
    "code.edit": {
      "description": "Edit a file in the repository.",
      "commands": [],
      "examples": [
        "write or change a source file, a test, or a doc"
      ]
    },
    "spec.approve": {
      "description": "Start building a Spec: its approval.",
      "commands": [],
      "examples": [
        "the Spec, its tests, and its design are written, and Implement would start"
      ]
    },
    "spec.revise": {
      "description": "Change a Spec's tests, Acceptance, or design after its approval.",
      "commands": [],
      "examples": [
        "edit a test file an approved Spec lists",
        "change an approved Spec's Acceptance"
      ]
    },
    "git.commit": {
      "description": "Make a commit.",
      "commands": [
        "git commit*"
      ],
      "examples": []
    },
    "git.push": {
      "description": "Push commits to a remote.",
      "commands": [
        "git push*"
      ],
      "examples": []
    },
    "git.push.force": {
      "description": "Push that replaces history on the remote.",
      "irreversible": true,
      "commands": [
        "git push --force*",
        "git push -f*",
        "git push * --force*",
        "git push * -f*",
        "git push * +*",
        "git push --force-with-lease*",
        "git push * --force-with-lease*"
      ],
      "examples": [
        "a push whose refspec starts with +"
      ]
    },
    "git.history.rewrite": {
      "description": "Rewrite commits others may have, or discard uncommitted work: a push of a rebased or amended branch is a force push, which asks.",
      "irreversible": true,
      "commands": [
        "git reset --hard*",
        "git filter-branch*",
        "git filter-repo*"
      ],
      "examples": [
        "squash or reorder commits already pushed"
      ]
    },
    "git.branch.delete": {
      "description": "Delete a branch, here or on a remote.",
      "irreversible": true,
      "commands": [
        "git branch -d*",
        "git branch -D*",
        "git branch --delete*",
        "git push * --delete*",
        "git push * :*",
        "git push -d*",
        "git push --delete*",
        "git push * -d*"
      ],
      "examples": []
    },
    "git.tag.create": {
      "description": "Create or move a tag, such as a release tag.",
      "commands": [
        "git tag*"
      ],
      "examples": []
    },
    "pr.open": {
      "description": "Open a pull request or merge request (a PR/MR).",
      "commands": [
        "gh pr create*",
        "glab mr create*"
      ],
      "examples": []
    },
    "pr.merge": {
      "description": "Merge work into the default branch: merge a PR/MR, or merge locally.",
      "commands": [
        "gh pr merge*",
        "glab mr merge*"
      ],
      "examples": [
        "git merge into the default branch"
      ]
    },
    "workflow.run": {
      "description": "Start or re-run a CI workflow by hand, such as `gh workflow run ci.yml` or `gh run rerun 123`. One whose name, in any of its three common cases, holds release, publish, or deploy is also `release.publish` or `deploy.run`, which ask. A workflow named by its number shows no name, so it reports: check what it runs first.",
      "commands": [
        "gh workflow run*",
        "gh run rerun*",
        "gh api *dispatches*",
        "gh api *actions/runs/*/rerun*",
        "glab ci run*",
        "glab ci trigger*",
        "glab ci retry*",
        "glab api *POST*pipeline*"
      ],
      "examples": [
        "re-run CI on a branch by hand"
      ]
    },
    "network.listen": {
      "description": "Listen for connections from other devices on the network, such as `aidd prototype --serve --lan`, which serves a design to a phone. Any device on that network can then reach it, so the agent says it started one. A listener on 127.0.0.1 alone reaches only this machine and is no such action.",
      "commands": [
        "*aidd*prototype*--lan*",
        "*serve*--lan*"
      ],
      "examples": [
        "start a development server on every interface, such as `vite --host`, or `python3 -m http.server`, which listens on every interface unless given `--bind 127.0.0.1`"
      ]
    },
    "commit_status.post": {
      "description": "Post a commit status, a check's result for a commit, such as `gh api repos/o/r/statuses/<sha> -f context=tests -f state=success`. CI posts these. Reading them (`commits/<sha>/statuses`) is no post, or create a check run (`gh api …/check-runs` with fields, or a GraphQL mutation, or a query read from a file). The ruleset counts a check only from GitHub Actions, so this is a second layer.",
      "commands": [
        "gh api */statuses/*",
        "gh api *check-runs* -f*",
        "gh api *check-runs* -F*",
        "gh api *check-runs* --field*",
        "gh api *check-runs* --raw-field*",
        "gh api *check-runs* --input*",
        "gh api *-X POST*check-runs*",
        "gh api *--method POST*check-runs*",
        "gh api graphql*createCheckRun*",
        "gh api * -f* *check-runs*",
        "gh api * -F* *check-runs*",
        "gh api * --field* *check-runs*",
        "gh api * --raw-field* *check-runs*",
        "gh api * --input* *check-runs*",
        "gh api *-XPOST*check-runs*",
        "gh api *-X=POST*check-runs*",
        "gh api *--method=POST*check-runs*",
        "gh api *-X PATCH*check-runs*",
        "gh api *-XPATCH*check-runs*",
        "gh api *--method PATCH*check-runs*",
        "gh api *--method=PATCH*check-runs*",
        "gh api -f* *check-runs*",
        "gh api -F* *check-runs*",
        "gh api --field* *check-runs*",
        "gh api --raw-field* *check-runs*",
        "gh api --input* *check-runs*",
        "gh api *graphql*mutation*",
        "gh api *mutation*graphql*",
        "gh api *graphql*query=@*",
        "gh api *query=@*graphql*",
        "gh api *graphql*--input*",
        "gh api *--input*graphql*"
      ],
      "examples": [
        "mark a commit's `tests` check as passed by hand"
      ]
    },
    "records.push": {
      "description": "Send this clone's records of history to a remote, where everyone with the repository reads them.",
      "irreversible": true,
      "commands": [
        "aidd records push*",
        "*aidd*records*push*",
        "git push * refs/aidd/*",
        "git push * *:refs/aidd/*"
      ],
      "examples": [
        "a push of the ref refs/aidd/records by any other means"
      ]
    },
    "deploy.run": {
      "description": "Deploy to an environment people use.",
