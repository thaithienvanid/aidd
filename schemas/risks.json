    "migration.run": {
      "description": "Run a migration on a database other people use, such as staging or production, or with the tool's force or production flag.",
      "irreversible": true,
      "commands": [
        "php artisan migrate --force*",
        "php artisan migrate*--force*",
        "php artisan migrate*--env*prod*",
        "prisma migrate deploy*",
        "wrangler d1 migrations apply*--remote*",
        "rails db:*RAILS_ENV=production*",
        "RAILS_ENV=production rails db:*",
        "DJANGO_SETTINGS_MODULE=*prod* python manage.py migrate*",
        "python manage.py migrate*--settings*prod*",
        "atlas migrate apply*--env*prod*",
        "flyway*-environment=prod*",
        "flyway*-configFiles=*prod*"
      ],
      "examples": [
        "apply migrations to staging or production",
        "a migration whose connection string or environment names a shared database"
      ]
    },
    "migration.run.local": {
      "description": "Run new migrations forward on a database only this checkout uses, such as the local development database.",
      "commands": [
        "php artisan migrate",
        "php artisan migrate --*",
        "alembic upgrade*",
        "python manage.py migrate*",
        "prisma migrate dev*",
        "drizzle-kit migrate*",
