{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidd:1:epic",
  "title": "Epic",
  "description": "Optional container: one outcome delivered by several Specs. When two teams share it, the Epic context is their only shared glossary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aidd_version",
    "kind",
    "id",
    "title",
    "goal",
    "status"
  ],
  "properties": {
    "aidd_version": {
      "$ref": "urn:aidd:1:common#/$defs/aidd_version"
    },
    "kind": {
      "const": "epic",
      "description": "Object kind. Always `epic`."
    },
    "id": {
      "$ref": "urn:aidd:1:common#/$defs/id"
    },
    "parent": {
      "$ref": "urn:aidd:1:common#/$defs/id",
      "description": "Optional Initiative id."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "One line. `locale` may apply."
    },
    "goal": {
      "$ref": "urn:aidd:1:common#/$defs/goal"
    },
    "status": {
      "$ref": "urn:aidd:1:common#/$defs/container_status"
    },
    "labels": {
      "$ref": "urn:aidd:1:common#/$defs/labels"
    },
    "relations": {
      "$ref": "urn:aidd:1:common#/$defs/relations"
    },
    "owner_teams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Teams with Specs under this Epic. Two or more turns on Multi-team."
    },
    "context": {
      "type": "string",
      "description": "Shared terms and constraints for every Spec under this Epic."
    },
    "covers": {
      "type": "array",
      "items": {
        "$ref": "urn:aidd:1:common#/$defs/id"
      },
      "uniqueItems": true,
      "description": "The ids of the proposal needs this Epic delivers, when it came from an accepted proposal."
    }
  }
}
