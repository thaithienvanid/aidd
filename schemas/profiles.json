{
  "description": "The profiles: each is a description plus the full set of gates a config's `gates` mapping starts from and may only tighten (the gates validate against config.schema.json#/properties/gates). `order` runs from the loosest to the strictest. Implicit input to every verifier: a conformance case names only its profile.",
  "order": ["solo", "team", "org", "audited"],
  "profiles": {
    "solo": {
      "description": "One person directs agents and approves. Separation of duties is waived and recorded. Compensating controls: SHA-bound tests, protected paths, a deliberate approve comment, and a cool-off on major.",
      "separation_of_duties": false,
      "spec_approval_routes": ["major"],
      "specialist_spec_approval": false,
      "approvals": { "standard": 0, "minor": 1, "normal": 1, "major": 1, "emergency": 1 },
      "specialist_approvals": 0,
      "cooloff_minutes": { "standard": 0, "minor": 0, "normal": 0, "major": 30, "emergency": 0 },
      "policy_required_routes": [],
      "provenance": "declare",
      "red_green": "warn",
      "standard_changes": true,
      "observe_required_routes": ["major"],
      "max_changed_lines": { "minor": 50, "normal": 800, "major": 800 },
      "unlinked_authors": "warn",
      "spec_approval_proof": "optional",
      "approval_carry": "trivial_rebase",
      "approval_carry_routes": ["minor", "normal", "major"],
      "local_approvals": "any",
      "max_open_per_approver": 0,
      "escalate_after_minutes": 0
    },
    "team": {
      "description": "One or a few teams on one repo. Human Spec approval before implementation, separation of duties against the authors, and a specialist Approver on major.",
      "separation_of_duties": true,
      "spec_approval_routes": ["normal", "major"],
      "specialist_spec_approval": false,
      "approvals": { "standard": 0, "minor": 1, "normal": 1, "major": 1, "emergency": 1 },
      "specialist_approvals": 1,
      "cooloff_minutes": { "standard": 0, "minor": 0, "normal": 0, "major": 0, "emergency": 0 },
      "policy_required_routes": [],
      "provenance": "declare",
      "red_green": "require",
      "standard_changes": true,
      "observe_required_routes": ["major"],
      "max_changed_lines": { "minor": 50, "normal": 400, "major": 400 },
      "unlinked_authors": "warn",
      "spec_approval_proof": "optional",
      "approval_carry": "trivial_rebase",
      "approval_carry_routes": ["minor", "normal", "major"],
      "local_approvals": "any",
      "max_open_per_approver": 3,
      "escalate_after_minutes": 0
    },
    "org": {
      "description": "Many teams and repos. Team plus a bound Policy on major and emergency.",
      "separation_of_duties": true,
      "spec_approval_routes": ["normal", "major"],
      "specialist_spec_approval": false,
      "approvals": { "standard": 0, "minor": 1, "normal": 1, "major": 1, "emergency": 1 },
      "specialist_approvals": 1,
      "cooloff_minutes": { "standard": 0, "minor": 0, "normal": 0, "major": 0, "emergency": 0 },
      "policy_required_routes": ["major", "emergency"],
      "provenance": "declare",
      "red_green": "require",
      "standard_changes": true,
      "observe_required_routes": ["major"],
      "max_changed_lines": { "minor": 50, "normal": 400, "major": 400 },
      "unlinked_authors": "warn",
      "spec_approval_proof": "optional",
      "approval_carry": "trivial_rebase",
      "approval_carry_routes": ["minor", "normal"],
      "local_approvals": "any",
      "max_open_per_approver": 3,
      "escalate_after_minutes": 0
    },
    "audited": {
      "description": "Finance, health, and public sector. Two Approvers and a specialist Approver on major, a Policy on every route, a provenance trailer on every commit, no standard changes, and a guard that blocks when it cannot run.",
      "separation_of_duties": true,
      "spec_approval_routes": ["normal", "major"],
      "specialist_spec_approval": true,
      "approvals": { "standard": 0, "minor": 1, "normal": 1, "major": 2, "emergency": 1 },
      "specialist_approvals": 1,
      "cooloff_minutes": { "standard": 0, "minor": 0, "normal": 0, "major": 0, "emergency": 0 },
      "policy_required_routes": ["minor", "normal", "major", "emergency"],
      "provenance": "every_commit",
      "red_green": "require",
      "standard_changes": false,
      "observe_required_routes": ["normal", "major"],
      "max_changed_lines": { "minor": 50, "normal": 400, "major": 300 },
      "unlinked_authors": "fail",
      "spec_approval_proof": "require",
      "approval_carry": "none",
      "approval_carry_routes": [],
      "local_approvals": "signed",
      "max_open_per_approver": 3,
      "escalate_after_minutes": 0
    }
  }
}
