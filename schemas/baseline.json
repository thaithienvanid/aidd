{
  "description": "The baseline every config inherits and cannot disable: protected_paths (always route major; the list includes every path a supported agent harness reads as instructions or runs as a hook, which `aidd gen-docs` merges in from src/aidd/harnesses.py), risk_rules (each validates against config.schema.json#/properties/risk_rules/items), agent_coauthors, and agent_accounts (platform logins that are always agents, such as the accounts GitHub Copilot reviews and codes as; an approval from one never counts, `merge_approval.agent_approval`). Implicit input to every verifier.",
  "protected_paths": [
    ".aidd/**",
    ".github/workflows/**",
    ".github/actions/**",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    ".gitlab-ci.yml",
    ".gitlab/**",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/GEMINI.md",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".cursorrules",
    ".windsurfrules",
    ".github/copilot-instructions.md",
    ".github/instructions/**",
    ".github/skills/**",
    ".mcp.json",
    ".vscode/mcp.json",
    "**/AGENTS.override.md",
    "**/CLAUDE.local.md",
    ".gemini/**",
    ".github/prompts/**",
    ".github/agents/**",
    ".devcontainer/**",
    "orca.yaml",
    ".worktreeinclude",
    ".husky/**",
    ".githooks/**",
    ".pre-commit-config.yaml",
    "lefthook.yml",
    ".lefthook.yml",
    ".gitmodules",
    ".github/dependabot.yml",
    ".github/dependabot.yaml",
    "renovate.json",
    "renovate.json5",
    ".renovaterc",
    ".renovaterc.json",
    ".github/renovate.json",
    ".github/renovate.json5",
    "Jenkinsfile",
    "**/Jenkinsfile",
    ".circleci/**",
    "azure-pipelines.yml",
    ".azure-pipelines/**",
    ".buildkite/**",
    "bitbucket-pipelines.yml",
    ".drone.yml",
    ".travis.yml",
    ".kiro/**",
    ".roo/**",
    ".clinerules",
    ".clinerules/**",
    ".windsurf/**",
    ".continue/**",
    ".aider*",
    ".junie/**",
    ".amazonq/**",
    ".trae/**",
    ".augment/**",
    "**/AGENT.md",
    ".github/copilot/**",
    "action.yml",
    "action.yaml",
    "**/.github/actions/**",
    "cloudbuild.yaml",
    "cloudbuild.yml",
    ".tekton/**",
    ".woodpecker.yml",
    ".woodpecker.yaml",
    ".woodpecker/**",
    "install.sh",
    "**/install.sh",
    "pyproject.toml",
    "**/pyproject.toml",
    "SECURITY.md",
    "**/SECURITY.md",
    "GOVERNANCE.md",
    "RELEASING.md",
    "REVIEW.md",
    "setup.py",
    "setup.cfg",
    ".github/hooks/**",
    ".agent/rules/**",
    ".devin/**",
    ".cline/**",
    ".roorules",
    ".roomodes",
    ".amp/**",
    "opencode.json",
    "opencode.jsonc",
    ".opencode/**",
    ".zed/**",
    ".rules",
    "WARP.md",
    ".warp/**",
    "QWEN.md",
    ".qwen/**",
    ".augment-guidelines",
    ".factory/**",
    ".goosehints",
    ".goose/**",
    ".grok/**",
    ".vibe/**",
    ".aiderignore/**",
    "CONVENTIONS.md"
  ],
  "risk_rules": [
    {
      "name": "baseline:dependencies",
      "route": "normal",
      "dimensions": [
        "third_party"
      ],
      "paths": [
        "**/package.json",
        "**/package-lock.json",
        "**/pnpm-lock.yaml",
        "**/yarn.lock",
        "**/bun.lockb",
        "**/bun.lock",
        "**/requirements*.txt",
        "**/pyproject.toml",
        "**/poetry.lock",
        "**/uv.lock",
        "**/Pipfile",
        "**/Pipfile.lock",
        "**/go.mod",
        "**/go.sum",
        "**/Cargo.toml",
        "**/Cargo.lock",
        "**/Gemfile",
        "**/Gemfile.lock",
        "**/pom.xml",
        "**/build.gradle",
        "**/build.gradle.kts",
        "**/*.csproj",
        "**/packages.lock.json",
        "**/composer.json",
        "**/composer.lock",
        "**/Package.swift",
        "**/Package.resolved",
        "**/pubspec.yaml",
        "**/pubspec.lock",
        "**/.npmrc",
        "**/.yarnrc",
        "**/.yarnrc.yml",
        "**/.pnpmfile.cjs",
        "**/setup.py",
        "**/setup.cfg",
        "**/requirements*.in",
        "**/go.work",
        "**/go.work.sum",
        "**/*.gradle",
        "**/*.gradle.kts",
        "**/gradle.properties",
        "**/libs.versions.toml",
        "**/.terraform.lock.hcl",
        "**/Podfile",
        "**/Podfile.lock",
        "**/Chart.lock",
        "**/nuget.config",
        "**/NuGet.Config",
        "**/settings.xml"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:build-tooling",
      "route": "normal",
      "dimensions": [
        "third_party"
      ],
      "paths": [
        "**/gradle/wrapper/**",
        "**/gradlew",
        "**/gradlew.bat",
        "**/mvnw",
        "**/mvnw.cmd",
        "**/.mvn/**",
        "**/Makefile",
        "**/justfile",
        "**/Taskfile.yml",
        "**/Taskfile.yaml",
        "**/noxfile.py",
        ".tool-versions",
        ".nvmrc",
        ".node-version",
        ".python-version",
        "mise.toml",
        ".mise.toml",
        ".gitattributes"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:containers",
      "route": "normal",
      "dimensions": [
        "third_party"
      ],
      "paths": [
        "**/Dockerfile",
        "**/*.dockerfile",
        "**/Containerfile",
        "**/docker-compose*.yml",
        "**/docker-compose*.yaml",
        "**/compose.yaml"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:test-config",
      "route": "normal",
      "dimensions": [],
      "paths": [
        "**/jest.config.*",
        "**/vitest.config.*",
        "**/pytest.ini",
        "**/conftest.py",
        "**/tox.ini",
        "**/.coveragerc",
        "**/phpunit.xml",
        "**/karma.conf.*",
        "**/playwright.config.*",
        "**/cypress.config.*"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:quality-config",
      "route": "normal",
      "dimensions": [],
      "paths": [
        "**/.eslintrc",
        "**/.eslintrc.*",
        "**/eslint.config.*",
        "**/tsconfig.json",
        "**/tsconfig.*.json",
        "**/.prettierrc",
        "**/.prettierrc.*",
        "**/prettier.config.*",
        "**/biome.json",
        "**/biome.jsonc",
        "**/ruff.toml",
        "**/.ruff.toml",
        "**/mypy.ini",
        "**/.mypy.ini",
        "**/.flake8",
        "**/.pylintrc",
        "**/.golangci.yml",
        "**/.golangci.yaml",
        "**/.golangci.toml",
        "**/.golangci.json",
        "**/clippy.toml",
        "**/.clippy.toml",
        "**/rustfmt.toml",
        "**/.rustfmt.toml",
        "**/.rubocop.yml",
        "**/phpstan.neon",
        "**/phpstan.neon.dist",
        "**/detekt.yml",
        "**/.swiftlint.yml",
        "**/analysis_options.yaml",
        "**/.eslintignore",
        "**/.prettierignore",
        "**/.stylelintrc*",
        "**/pyrightconfig.json",
        "**/.clang-tidy",
        "**/.swiftformat",
        "**/.scalafmt.conf",
        "**/.markdownlint*",
        "**/deno.json",
        "**/deno.jsonc"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:iac",
      "route": "normal",
      "dimensions": [
        "availability"
      ],
      "paths": [
        "**/*.tf",
        "**/*.tfvars",
        "**/terraform/**",
        "**/k8s/**",
        "**/kubernetes/**",
        "**/helm/**",
        "**/Chart.yaml",
        "**/charts/*/templates/**",
        "**/*.bicep",
        "**/cloudformation/**",
        "**/pulumi/**",
        "**/kustomization.yaml"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:migrations",
      "route": "major",
      "dimensions": [
        "data"
      ],
      "paths": [
        "**/migrations/**",
        "**/migrate/**",
        "**/alembic/**",
        "**/db/migration/**",
        "**/db/changelog/**",
        "**/db/schema.rb",
        "**/schema.prisma",
        "**/flyway/**",
        "**/liquibase/**"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:auth",
      "route": "major",
      "dimensions": [
        "security"
      ],
      "paths": [
        "**/auth/**",
        "**/authn/**",
        "**/authz/**",
        "**/iam/**",
        "**/rbac/**",
        "**/permissions/**",
        "**/*.rego"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**"
      ]
    },
    {
      "name": "baseline:secrets-crypto",
      "route": "major",
      "dimensions": [
        "security"
      ],
      "paths": [
        "**/crypto/**",
        "**/secrets/**",
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/*.p12"
      ],
      "exclude": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/third_party/**",
        "**/.env.example",
        "**/.env.sample",
        "**/.env.template",
        "**/.env.dist"
      ]
    }
  ],
  "agent_coauthors": {
    "emails": [
      "noreply@anthropic.com",
      "cursoragent@cursor.com",
      "codex@openai.com",
      "amp@ampcode.com"
    ],
    "email_patterns": [
      "*[bot]@*"
    ],
    "names": [
      "claude",
      "copilot",
      "codex",
      "cursor",
      "gemini",
      "antigravity",
      "devin",
      "aider",
      "windsurf",
      "cline",
      "roo",
      "kiro",
      "junie",
      "opencode",
      "deepseek",
      "openhands",
      "sweep",
      "chatgpt",
      "grok",
      "gpt"
    ]
  },
  "agent_accounts": [
    "copilot",
    "copilot-pull-request-reviewer",
    "copilot-pull-request-reviewer[bot]",
    "copilot-swe-agent",
    "copilot-swe-agent[bot]"
  ]
}
