{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidd:1:initiative",
  "title": "Initiative",
  "description": "Optional container: one outcome across several Epics. Aliases: Theme, Program.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aidd_version",
    "kind",
    "id",
    "title",
    "goal",
    "status"
  ],
  "properties": {
    "aidd_version": {
      "$ref": "urn:aidd:1:common#/$defs/aidd_version"
    },
    "kind": {
      "const": "initiative",
      "description": "Object kind. Always `initiative`."
    },
    "id": {
      "$ref": "urn:aidd:1:common#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "One line. `locale` may apply."
    },
    "goal": {
      "$ref": "urn:aidd:1:common#/$defs/goal"
    },
    "status": {
      "$ref": "urn:aidd:1:common#/$defs/container_status"
    },
    "labels": {
      "$ref": "urn:aidd:1:common#/$defs/labels"
    },
    "relations": {
      "$ref": "urn:aidd:1:common#/$defs/relations"
    },
    "owner_team": {
      "type": "string",
      "description": "Team accountable for the outcome."
    },
    "proposal": {
      "$ref": "urn:aidd:1:common#/$defs/id",
      "description": "The accepted proposal this Initiative delivers, so every change under it traces back to what was promised."
    }
  }
}
